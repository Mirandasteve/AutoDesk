# ===========================================================================
#  AutoDesk - git ignore rules
#
#  CRITICAL: backend/.env holds the real local PostgreSQL password and JWT
#  secrets. It is listed here and must never be committed. Only
#  backend/.env.example (which contains no secrets) is tracked.
# ===========================================================================

# ---- Secrets and local configuration ---------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
secrets.json
service-account*.json

# ---- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.installed.cfg
pip-wheel-metadata/

# ---- Virtual environments ----------------------------------------------------
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ---- Flask / SQLAlchemy ------------------------------------------------------
instance/
*.db
*.sqlite
*.sqlite3

# ---- Test / coverage / cache output -------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/
.cache
nosetests.xml

# ---- Node / frontend ---------------------------------------------------------
node_modules/
frontend/dist/
frontend/build/
frontend/.vite/
.vite/
*.tsbuildinfo

# ---- Logs ---------------------------------------------------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---- ML artefacts ------------------------------------------------------------
# The trained DistilBERT weights are ~268 MB. They are reproducible from
# ml/generate_data.py + ml/preprocess.py + ml/train.py, so they are not tracked.
# Delete the next two lines if you would rather commit the checkpoints.
backend/app/ml/saved_model/
ml/saved_model/
ml/runs/
*.safetensors
*.bin
!backend/app/ml/__init__.py

# ---- Editors and OS ----------------------------------------------------------
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# ---- Temp / scratch ----------------------------------------------------------
tmp/
temp/
scratch/
*.bak
*.orig
*.rej
# Local ONNX export files
backend/onnx-export/
