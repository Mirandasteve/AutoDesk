# ============================================================================
# AutoDesk - Backend Environment Configuration
#
# 1. Copy this file to `.env`
# 2. Fill in the values for your machine
# 3. `.env` is git-ignored - NEVER commit real passwords/secrets
# ============================================================================

# --- Flask ------------------------------------------------------------------
FLASK_APP=run.py
FLASK_DEBUG=1
SECRET_KEY=change-me-to-a-long-random-string-in-production

# --- Database (PostgreSQL 16) ----------------------------------------------
# Special characters in the password MUST be URL-encoded
#   @ -> %40    : -> %3A    / -> %2F    # -> %23
DATABASE_URL=postgresql+psycopg2://postgres:your_password_here@localhost:5432/autodesk_db

# --- JWT --------------------------------------------------------------------
# Generate a real one with:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-different-long-random-string
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=480

# --- CORS ------------------------------------------------------------------
# Comma separated list of allowed origins (Vite dev server)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Email (Flask-Mail) -----------------------------------------------------
# Leave MAIL_ENABLED=False to run locally without an SMTP server.
# Ticket submission never fails because of email problems - it is best-effort.
MAIL_ENABLED=False
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=it-helpdesk@company.com
MAIL_PASSWORD=your-email-app-password
MAIL_DEFAULT_SENDER=AutoDesk IT Helpdesk <no-reply@autodesk.local>
# Comma separated list of extra recipients for team-routing alerts
MAIL_ADMIN_RECIPIENTS=admin@autodesk.local

# --- Machine Learning -------------------------------------------------------
# Path to the fine-tuned DistilBERT sequence-classification checkpoint.
# Relative to the backend/ directory.
ML_MODEL_PATH=app/ml/saved_model
ML_MAX_LENGTH=256
# If the checkpoint is missing, fall back to a keyword classifier so the rest of
# the system stays usable. Set to False to make missing model a hard error.
ML_ALLOW_FALLBACK=True

# --- SLA (hours, per priority) ---------------------------------------------
# Central SLA configuration. Kept in .env so it can be tuned without code edits.
SLA_LOW_HOURS=24
SLA_MEDIUM_HOURS=8
SLA_HIGH_HOURS=4
SLA_CRITICAL_HOURS=2
# "Near SLA" warning threshold: fraction of the SLA window already elapsed.
SLA_NEAR_THRESHOLD=0.8

# --- Seed data --------------------------------------------------------------
# Credentials used by database/seed.sql and the seeding CLI command.
SEED_ADMIN_EMAIL=admin@autodesk.local
SEED_ADMIN_PASSWORD=Admin@123
SEED_DEFAULT_PASSWORD=Employee@123
